generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  userId    String   @unique
  password  String
  role      String   @default("USER") // SUPER_ADMIN, ADMIN, USER
  modules   String   @default("*") // Comma-separated modules e.g., "workers,companies,attendance"
  profileImage String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasksAssigned Task[] @relation("AssignedTasks")
  tasksCreated  Task[] @relation("CreatedTasks")
  companyes      Company[] // Companyes managed by this user
  notifications Notification[] @relation("UserNotifications")
}

model Worker {
  id         String   @id @default(cuid())
  workerId   String   @unique // Employee ID
  name       String
  designation String?
  gender     String?
  bloodGroup String?
  religion   String?
  nationalId String?
  phone      String?
  address    String?  // Present Address
  permanentAddress String?
  joinDate   DateTime @default(now())
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  sectionId    String?
  section    Section?    @relation(fields: [sectionId], references: [id])
  subSectionId String?
  subSection SubSection? @relation(fields: [subSectionId], references: [id])
  grade      String?
  photoUrl   String?
  trainings  Training[] @relation("TrainingParticipants")
  trainingsLed Training[] @relation("TrainingTrainer")
  signatureUrl String?
  
  // Salary Information
  grossSalary         Float? @default(0)
  basicSalary         Float? @default(0)
  houseRent           Float? @default(0)
  conveyanceAllowance Float? @default(0)
  medicalAllowance    Float? @default(0)
  
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  deletedAt  DateTime?
  confirmed6mAt       DateTime?
  confirmed3yAt       DateTime?
  confirmed6mRemarks  String?
  confirmed3yRemarks  String?

  // Emergency Contact & Nominee Details
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  nomineeName              String?
  nomineeRelation          String?
  nomineeNid               String?
  nomineePhone             String?
  nomineePhotoUrl          String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendances              Attendance[]
  settlements              Settlement[]
  leaves                   LeaveRequest[]
  documents                WorkerDocument[]
  careerHistory            CareerHistory[]
  disciplinaryRecords      DisciplinaryRecord[]
  skills                   WorkerSkill[]
  complianceCertifications ComplianceCertification[]
  hostedVisitors           VisitorLog[]
  hiredApplicants          Applicant[] @relation("ApplicantWorker")

  @@index([companyId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([subSectionId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([isDeleted, isActive])
  @@index([companyId, isDeleted])
  @@index([companyId, isDeleted, isActive])
  @@index([subSectionId, isDeleted, isActive])
  @@index([sectionId, isDeleted, isActive])
  @@index([joinDate])
  @@index([designation])
  @@index([name])
  @@index([phone])
  @@index([createdAt])
  @@index([isDeleted, createdAt])
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  location    String?
  managerId   String?
  manager     User?        @relation(fields: [managerId], references: [id])
  workers     Worker[]
  departments Department[]
  holidays    Holiday[]
  applicants  Applicant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         String      @id @default(cuid())
  name       String
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections   Section[]
  workers    Worker[]
  applicants Applicant[]
  @@index([companyId])
  @@index([name])
}

model Section {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subSections  SubSection[]
  workers      Worker[]
  @@index([departmentId])
  @@index([name])
}

model SubSection {
  id        String   @id @default(cuid())
  name      String
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  workers   Worker[]
  authorizedManpower Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  @@index([sectionId])
  @@index([name])
}

model Attendance {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  status    String   // PRESENT, ABSENT, LATE, LEAVE
  createdAt DateTime @default(now())

  @@index([workerId])
  @@index([date])
  @@index([status])
  @@index([date, status])
  @@index([workerId, date])
}

model Settlement {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  
  // Dates & Info
  resignApplyDate DateTime?
  lastWorkingDay  DateTime?
  serviceAge      String?
  
  // Salary Info
  grossSalary     Float? @default(0)
  basicSalary     Float? @default(0)
  houseRent       Float? @default(0)
  conveyanceAllowance Float? @default(0)
  medicalAllowance    Float? @default(0)
  
  // Leave & Work Day Info
  totalEarnLeaveDays      Float? @default(0)
  totalLateEarlyMinutes   Float? @default(0)
  currentMonthWorkingDays Float? @default(0)
  absentDays              Float? @default(0)

  // Pay Calculation - Payables
  serviceBenefitAmount   Float? @default(0)
  currentMonthWorkDayPay Float? @default(0)
  extraDutyOTPay         Float? @default(0)
  earnLeavePay           Float? @default(0)
  
  // Pay Calculation - Deductions
  deductMoneyAct2006 Float? @default(0)
  absentDeduction    Float? @default(0)
  lateEarlyDeduction Float? @default(0)
  
  // Totals
  payableSubTotal   Float? @default(0)
  deductionSubTotal Float? @default(0)
  totalPayAmount    Float? @default(0)
  amountInWords     String?
  bankAccNo         String?
  
  // Approvals & Status
  paymentReceiverDate DateTime?
  status    String   @default("PENDING") // PENDING, APPROVED, PAID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([status])
  @@index([createdAt])
  @@index([workerId, status])
}

model Training {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workers     Worker[]   @relation("TrainingParticipants")
  trainerId   String?
  trainer     Worker?    @relation("TrainingTrainer", fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
  @@index([trainerId])
  @@index([createdAt])
}

model Recruitment {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      String      @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  applicants  Applicant[]

  @@index([status])
  @@index([createdAt])
}

model Applicant {
  id              String      @id @default(cuid())
  name            String
  email           String?
  phone           String
  recruitmentId   String
  recruitment     Recruitment @relation(fields: [recruitmentId], references: [id])
  resumeUrl       String?
  status          String      @default("APPLIED") // APPLIED, INTERVIEWING, OFFERED, HIRED, REJECTED
  
  // ATS Pipeline Extensions
  stage           String      @default("APPLIED") // APPLIED, SHORTLISTED, SEWING_TEST, INTERVIEW, OFFERED, HIRED, REJECTED
  rating          Float?      @default(0)
  appliedRole     String?
  experienceYears Float?
  expectedSalary  Float?
  testScore       Float?
  testNotes       String?
  interviewNotes  String?
  companyId       String?
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hiredAsWorkerId String?
  hiredWorker     Worker?     @relation("ApplicantWorker", fields: [hiredAsWorkerId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([recruitmentId])
  @@index([stage])
  @@index([status])
  @@index([companyId])
  @@index([departmentId])
  @@index([hiredAsWorkerId])
  @@index([createdAt])
}

model LeaveRequest {
  id              String   @id @default(cuid())
  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  leaveType       String   // CASUAL, SICK, EARNED, MATERNITY, OTHER
  startDate       DateTime
  endDate         DateTime
  days            Float
  reason          String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  rejectionReason String?
  attachmentUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workerId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([leaveType])
  @@index([workerId, status])
}

model Holiday {
  id          String   @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime
  type        String   @default("PUBLIC") // PUBLIC, REST_DAY, FESTIVAL, SPECIAL
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([companyId])
}

model WorkerDocument {
  id         String   @id @default(cuid())
  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  title      String
  category   String   // NID, CERTIFICATE, MEDICAL, CONTRACT, OTHER
  fileUrl    String   @db.Text
  fileType   String?
  fileSize   String?
  uploadedAt DateTime @default(now())

  @@index([workerId])
  @@index([category])
}

model CareerHistory {
  id                  String   @id @default(cuid())
  workerId            String
  worker              Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  changeType          String   // PROMOTION, TRANSFER, INCREMENT, GRADE_CHANGE, JOINING
  effectiveDate       DateTime
  previousDesignation String?
  newDesignation      String?
  previousDepartment  String?
  newDepartment       String?
  previousGrade       String?
  newGrade            String?
  previousSalary      Float?
  newSalary           Float?
  remarks             String?
  createdAt           DateTime @default(now())

  @@index([workerId])
  @@index([effectiveDate])
}

model DisciplinaryRecord {
  id           String   @id @default(cuid())
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  incidentDate DateTime
  actionType   String   // SHOW_CAUSE, VERBAL_WARNING, WRITTEN_WARNING, SUSPENSION, PENALTY
  subject      String
  description  String   @db.Text
  actionTaken  String?
  status       String   @default("RESOLVED") // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  documentsUrl String?
  createdAt    DateTime @default(now())

  @@index([workerId])
  @@index([status])
}

model VisitorLog {
  id               String    @id @default(cuid())
  passNumber       String    @unique
  visitorName      String
  visitorPhone     String
  visitorCompany   String?
  visitorNid       String?
  hostWorkerId     String?
  hostWorker       Worker?   @relation(fields: [hostWorkerId], references: [id], onDelete: SetNull)
  hostName         String?
  purpose          String
  belongings       String?
  checkInTime      DateTime  @default(now())
  checkOutTime     DateTime?
  expectedDuration Int?      @default(60) // in minutes
  status           String    @default("IN_PREMISES") // IN_PREMISES, CHECKED_OUT, OVERSTAYED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([hostWorkerId])
  @@index([checkInTime])
}

model WorkerSkill {
  id             String    @id @default(cuid())
  workerId       String
  worker         Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skillCategory  String    // SEWING, QUALITY, ELECTRICAL, MAINTENANCE, SAFETY, MANAGEMENT
  skillName      String
  proficiency    String    // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  certifiedDate  DateTime?
  expiryDate     DateTime?
  certifyingBody String?
  status         String    @default("VALID") // VALID, EXPIRING_SOON, EXPIRED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workerId])
  @@index([skillCategory])
  @@index([updatedAt])
}

model ComplianceCertification {
  id                String   @id @default(cuid())
  workerId          String
  worker            Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type              String   // FIRE_SAFETY, FIRST_AID, CHEMICAL_HANDLING, RSC_AUDIT, BSCI_SOCIAL
  issueDate         DateTime
  expiryDate        DateTime
  certificateNumber String?
  issuingAuthority  String?
  status            String   @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED
  attachmentUrl     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workerId])
  @@index([type])
  @@index([expiryDate])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  deadline    DateTime?
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE
  
  assigneeId  String?
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  
  creatorId   String
  creator     User     @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assigneeId])
  @@index([creatorId])
  @@index([status])
  @@index([assigneeId, status])
  @@index([deadline])
  @@index([createdAt])
  @@index([assigneeId, deadline])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  action    String   // e.g. CREATE, UPDATE, DELETE
  module    String   // e.g. WORKERS, SETTLEMENTS
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
}
